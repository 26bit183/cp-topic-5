#include <stdio.h>
#include <string.h>

int main() {
    char name[100];
    int i, len;

    printf("Enter full name: ");
    gets(name);

    len = strlen(name);

    // Print first letter of first name
    printf("%c. ", name[0]);

    // Print first letter after each space, except last word
    for(i = 0; i < len; i++) {
        if(name[i] == ' ') {
            int j, lastSpace = i;
            for(j = i + 1; j < len; j++) {
                if(name[j] == ' ') lastSpace = j;
            }
            if(lastSpace != i) {
                printf("%c. ", name[i + 1]);
            } else {
                printf("%s", &name[i + 1]);
                break;
            }
        }
    }

    return 0;
}
